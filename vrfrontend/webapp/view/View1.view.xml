                        <!-- High-risk vendors -->
                        <VBox class="vrxCard vrxAccentRed">
                            <Title
                                text="{i18n>listHighRisk}"
                                level="H3"
                                class="vrxSectionTitle"
                            />
                            <Table
                                id="highRiskTable"
                                items="{recent>/highRiskVendors}"
                                noDataText="{i18n>listNoData}"
                                class="vrxDashTable"
                            >
                                <columns>
                                    <Column>
                                        <Text text="{i18n>colVendor}" />
                                    </Column>
                                    <Column
                                        minScreenWidth="Tablet"
                                        demandPopin="true"
                                    >
                                        <Text text="{i18n>colStatus}" />
                                    </Column>
                                    <Column>
                                        <Text text="{i18n>colRisk}" />
                                    </Column>
                                </columns>
                                <items>
                                    <ColumnListItem
                                        type="Navigation"
                                        press=".onHighRiskVendorPress"
                                    >
                                        <cells>
                                            <ObjectIdentifier
                                                title="{recent>vendorName}"
                                                text="{recent>vendorCode}"
                                            />
                                            <Text text="{recent>statusText}" />
                                            <ObjectStatus
                                                text="{recent>riskText}"
                                                state="{recent>riskState}"
                                            />
                                        </cells>
                                    </ColumnListItem>
                                </items>
                            </Table>
                        </VBox>
                    </layout:content>
                </layout:Grid>

