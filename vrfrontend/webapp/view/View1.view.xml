                        <!-- Vendor risk -->

                        <VBox class="vrxCard">
                            <Title
                                text="{i18n>chartVendorRisk}"
                                level="H3"
                                class="vrxSectionTitle"
                            />

                            <Text
                                text="{i18n>chartNoData}"
                                class="vrxMutedText"
                                visible="{= ${riskChart>/levels}.length === 0 }"
                            />

                            <viz:VizFrame
                                id="riskViz"
                                uiConfig="{applicationSet:'fiori'}"
                                height="320px"
                                width="100%"
                                vizType="donut"
                            >
                                <viz:dataset>
                                    <viz.data:FlattenedDataset
                                        data="{riskChart>/levels}"
                                    >
                                        <viz.data:dimensions>
                                            <viz.data:DimensionDefinition
                                                name="Risk Level"
                                                value="{riskChart>status}"
                                            />
                                        </viz.data:dimensions>

                                        <viz.data:measures>
                                            <viz.data:MeasureDefinition
                                                name="Vendor Count"
                                                value="{riskChart>count}"
                                            />
                                        </viz.data:measures>
                                    </viz.data:FlattenedDataset>
                                </viz:dataset>

                                <viz:feeds>
                                    <viz.feeds:FeedItem
                                        uid="size"
                                        type="Measure"
                                        values="Vendor Count"
                                    />

                                    <viz.feeds:FeedItem
                                        uid="color"
                                        type="Dimension"
                                        values="Risk Level"
                                    />
                                </viz:feeds>
                            </viz:VizFrame>
                        </VBox>

                        <!-- PO status -->
                        <VBox class="vrxCard">
                            <Title
                                text="{i18n>chartPOStatus}"
                                level="H3"
                                class="vrxSectionTitle"
                            />
                            <Text
                                text="{i18n>chartNoData}"
                                class="vrxMutedText"
                                visible="{= ${poChart>/poStatus}.length === 0 }"
                            />
                            <viz:VizFrame
                                id="idVizFrames"
                                uiConfig="{applicationSet:'fiori'}"
                                height="320px"
                                width="100%"
                                vizType="bar"
                            >
                                <viz:dataset>
                                    <viz.data:FlattenedDataset
                                        data="{poChart>/poStatus}"
                                    >
                                        <viz.data:dimensions>
                                            <viz.data:DimensionDefinition
                                                name="Purchase Order Status"
                                                value="{poChart>status}"
                                            />
                                        </viz.data:dimensions>
                                        <viz.data:measures>
                                            <viz.data:MeasureDefinition
                                                name="PO Count"
                                                value="{poChart>count}"
                                            />
                                        </viz.data:measures>
                                    </viz.data:FlattenedDataset>
                                </viz:dataset>
                                <viz:feeds>
                                    <viz.feeds:FeedItem
                                        uid="valueAxis"
                                        type="Measure"
                                        values="PO Count"
                                    />
                                    <viz.feeds:FeedItem
                                        uid="categoryAxis"
                                        type="Dimension"
                                        values="Purchase Order Status"
                                    />
                                </viz:feeds>
                            </viz:VizFrame>
                        </VBox>

