                /> -->

                <layout:Grid
                    defaultSpan="XL6 L6 M12 S12"
                    hSpacing="1"
                    vSpacing="1"
                >
                    <layout:content>
                        <!-- Recent purchase orders -->
                        <VBox class="vrxCard">
                            <Title
                                text="{i18n>chartInvoiceStatus}"
                                level="H3"
                                class="vrxSectionTitle"
                            />
                            <Text
                                text="{i18n>chartNoData}"
                                class="vrxMutedText"
                                visible="{= ${invoiceChart>/statuses}.length === 0 }"
                            />
                            <viz:VizFrame
                                id="invoiceViz"
                                uiConfig="{applicationSet:'fiori'}"
                                height="320px"
                                width="100%"
                                vizType="bar"
                            >
                                <viz:dataset>
                                    <viz.data:FlattenedDataset
                                        data="{invoiceChart>/statuses}"
                                    >
                                        <viz.data:dimensions>
                                            <viz.data:DimensionDefinition
                                                name="Invoice Status"
                                                value="{invoiceChart>status}"
                                            />
                                        </viz.data:dimensions>
                                        <viz.data:measures>
                                            <viz.data:MeasureDefinition
                                                name="Invoice Count"
                                                value="{invoiceChart>count}"
                                            />
                                        </viz.data:measures>
                                    </viz.data:FlattenedDataset>
                                </viz:dataset>
                                <viz:feeds>
                                    <viz.feeds:FeedItem
                                        uid="valueAxis"
                                        type="Measure"
                                        values="Invoice Count"
                                    />
                                    <viz.feeds:FeedItem
                                        uid="categoryAxis"
                                        type="Dimension"
                                        values="Invoice Status"
                                    />
                                </viz:feeds>
                            </viz:VizFrame>
                        </VBox>

                        <VBox class="vrxCard">
                            <Title
                                text="{i18n>listRecentPO}"
                                level="H3"
                                class="vrxSectionTitle"
                            />
                            <Table
                                id="recentPOTable"
                                items="{recent>/purchaseOrders}"
                                noDataText="{i18n>listNoData}"
                                class="vrxDashTable"
                            >
                                <columns>
                                    <Column>
                                        <Text text="{i18n>colPO}" />
                                    </Column>
                                    <Column
                                        minScreenWidth="Tablet"
                                        demandPopin="true"
                                    >
                                        <Text text="{i18n>colDate}" />
                                    </Column>
                                    <Column
                                        hAlign="End"
                                        minScreenWidth="Tablet"
                                        demandPopin="true"
                                    >
                                        <Text text="{i18n>colAmount}" />
                                    </Column>
                                    <Column>
                                        <Text text="{i18n>colStatus}" />
                                    </Column>
                                </columns>
                                <items>
                                    <ColumnListItem
                                        type="Navigation"
                                        press=".onRecentPOPress"
                                    >
                                        <cells>
                                            <ObjectIdentifier
                                                title="{recent>poNumber}"
                                            />
                                            <Text text="{recent>poDateText}" />
                                            <ObjectNumber
                                                number="{path: 'recent>totalAmount', type: 'sap.ui.model.type.Float', formatOptions: {minFractionDigits: 2, maxFractionDigits: 2}}"
                                                unit="{recent>currency}"
                                            />
                                            <ObjectStatus
                                                text="{recent>statusText}"
                                                state="{path: 'recent>poStatus', formatter: '.formatter.poStatusState'}"
                                            />
                                        </cells>
                                    </ColumnListItem>
                                </items>
                            </Table>
                        </VBox>
