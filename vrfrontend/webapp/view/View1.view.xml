<mvc:View
    controllerName="vrfrontend.controller.View1"
    xmlns="sap.m"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:core="sap.ui.core"
    xmlns:layout="sap.ui.layout"
    xmlns:viz="sap.viz.ui5.controls"
    xmlns:viz.feeds="sap.viz.ui5.controls.common.feeds"
    xmlns:viz.data="sap.viz.ui5.data"
    displayBlock="true"
    height="100%"
>
    <Page
        id="mainPage"
        showHeader="false"
        class="vrxPage"
    >
        <content>
            <VBox class="vrxDashboardBody">
                <HBox
                    width="100%"
                    alignItems="Center"
                    class="vrxPageHeader sapUiSmallMarginBottom"
                >
                    <Button
                        icon="sap-icon://nav-back"
                        type="Transparent"
                        tooltip="{i18n>dashBack}"
                        press=".onNav"
                        class="vrxBackButton sapUiSmallMarginEnd"
                    />

                    <VBox class="vrxHeaderText">
                        <Title
                            text="{i18n>dashTitle}"
                            level="H1"
                            wrapping="true"
                            class="vrxPageHeaderTitle"
                        />

                        <Text
                            text="{i18n>dashSubtitle}"
                            wrapping="true"
                            class="vrxPageHeaderSubtitle"
                        />
                    </VBox>
                </HBox>

                <MessageStrip
                    text="{i18n>dashLoadError}"
                    type="Error"
                    showIcon="true"
                    visible="{kpi>/error}"
                    class="sapUiSmallMarginBottom"
                />

                <!-- PROCUREMENT TEAM PAGES -->
                <!-- <Title
                    text="Procurement Team Pages"
                    level="H2"
                    class="vrxSectionTitle sapUiSmallMarginTop sapUiSmallMarginBottom"
                /> -->

                <layout:Grid
                    width="100%"
                    defaultSpan="XL4 L4 M4 S12"
                    hSpacing="1"
                    vSpacing="1"
                    class="vrxKpiGrid"
                >
                    <layout:content>
                        <GenericTile
                            header="{i18n>kpiVendorsTotal}"
                            subheader="Overall vendor count"
                            frameType="OneByOne"
                            class="vrxKpiTile vrxAccentTeal"
                            press=".onVendorPress"
                        >
                            <TileContent>
                                <NumericContent
                                    value="{kpi>/vendorsTotal}"
                                    icon="sap-icon://supplier"
                                    valueColor="Neutral"
                                    withMargin="false"
                                />
                            </TileContent>
                        </GenericTile>

                        <GenericTile
                            header="{i18n>kpiPOTotal}"
                            subheader="All purchase orders"
                            frameType="OneByOne"
                            class="vrxKpiTile vrxAccentPurple"
                            press=".onPurchaseOrderPress"
                        >
                            <TileContent>
                                <NumericContent
                                    value="{kpi>/poTotal}"
                                    icon="sap-icon://sales-order"
                                    valueColor="Neutral"
                                    withMargin="false"
                                />
                            </TileContent>
                        </GenericTile>

                        <GenericTile
                            header="{i18n>kpiInvoiceTotal}"
                            subheader="All invoices"
                            frameType="OneByOne"
                            class="vrxKpiTile vrxAccentTeal"
                            press=".onInvoicePress"
                        >
                            <TileContent>
                                <NumericContent
                                    value="{kpi>/invoiceTotal}"
                                    icon="sap-icon://receipt"
                                    valueColor="Neutral"
                                    withMargin="false"
                                />
                            </TileContent>
                        </GenericTile>
                    </layout:content>
                </layout:Grid>

